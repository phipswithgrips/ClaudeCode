-- Fotos zu Rezepten; die Bilddatei liegt auf dem Server unter ihrem SHA-256.
CREATE TABLE photo (
    id TEXT NOT NULL PRIMARY KEY,
    updated_at TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    server_rev INTEGER NOT NULL DEFAULT 0,
    dirty INTEGER NOT NULL DEFAULT 0,
    recipe_id TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    sha256 TEXT NOT NULL,
    mime TEXT NOT NULL DEFAULT 'image/jpeg',
    width INTEGER,
    height INTEGER
);

CREATE INDEX photo_recipe ON photo(recipe_id);
CREATE INDEX photo_dirty ON photo(dirty);

upsert:
INSERT OR REPLACE INTO photo VALUES ?;

selectById:
SELECT * FROM photo WHERE id = ?;

selectVisible:
SELECT * FROM photo WHERE deleted = 0 ORDER BY recipe_id, sort_order;

selectDirty:
SELECT * FROM photo WHERE dirty = 1;

markClean:
UPDATE photo SET dirty = 0, server_rev = :rev WHERE id = :id AND updated_at = :updatedAt;

deleteAll:
DELETE FROM photo;
