-- Einkaufsliste; wird wie Rezepte synchronisiert.
CREATE TABLE shopping_item (
    id TEXT NOT NULL PRIMARY KEY,
    updated_at TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    server_rev INTEGER NOT NULL DEFAULT 0,
    dirty INTEGER NOT NULL DEFAULT 0,
    text TEXT NOT NULL DEFAULT '',
    checked INTEGER NOT NULL DEFAULT 0,
    recipe_id TEXT,
    recipe_title TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX shopping_item_dirty ON shopping_item(dirty);

upsert:
INSERT OR REPLACE INTO shopping_item VALUES ?;

selectById:
SELECT * FROM shopping_item WHERE id = ?;

selectVisible:
SELECT * FROM shopping_item WHERE deleted = 0 ORDER BY sort_order;

selectDirty:
SELECT * FROM shopping_item WHERE dirty = 1;

markClean:
UPDATE shopping_item SET dirty = 0, server_rev = :rev WHERE id = :id AND updated_at = :updatedAt;

deleteAll:
DELETE FROM shopping_item;
